# Matugen template for btop


# Colors should be in 6 or 2 character hexadecimal or single spaced rgb decimal: "#RRGGBB", "#BW" or "0-255 0-255 0-255"
# example for white: "#ffffff", "#ff" or "255 255 255".

# All graphs and meters can be gradients
# For single color graphs leave "mid" and "end" variable empty.
# Use "start" and "end" variables for two color gradient
# Use "start", "mid" and "end" for three color gradient

# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]=""

# Main text color
theme[main_fg]="#ECBEB8"

# Title color for boxes
theme[title]="#537e9c"

# Highlight color for keyboard shortcuts
theme[hi_fg]="{{colors.secondary.default.hex}}"

# Background color of selected item in processes box
theme[selected_bg]="#e1404a"

# Foreground color of selected item in processes box
theme[selected_fg]="#140002"

# Color of inactive/disabled text
theme[inactive_fg]="#83799b"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="{{colors.tertiary.default.hex}}"

# Cpu box outline color
theme[cpu_box]="#ECBEB8"

# Memory/disks box outline color
theme[mem_box]="#ECBEB8"

# Net up/down box outline color
theme[net_box]="#ECBEB8"

# Processes box outline color
theme[proc_box]="#ECBEB8"

# Box divider line and small boxes line color
theme[div_line]="#527e9b"

# Temperature graph colors
theme[temp_start]="#e1404a"
theme[temp_mid]="#537e9c"
theme[temp_end]="#e1404a"

# CPU graph colors
theme[cpu_start]="#e1404a"
theme[cpu_mid]="#537e9c"
theme[cpu_end]="#e1404a"

# Mem/Disk free meter
theme[free_start]="{{colors.secondary.default.hex}}"
theme[free_mid]=""
theme[free_end]="{{colors.secondary_container.default.hex}}"

# Mem/Disk cached meter
theme[cached_start]="{{colors.tertiary.default.hex}}"
theme[cached_mid]=""
theme[cached_end]="{{colors.tertiary_container.default.hex}}"

# Mem/Disk available meter
theme[available_start]="#e1404a"
theme[available_mid]=""
theme[available_end]="#e1404a"

# Mem/Disk used meter
theme[used_start]="#e1404a"
theme[used_mid]=""
theme[used_end]="#e1404a"

# Download graph colors
theme[download_start]="#e1404a"
theme[download_mid]="#537e9c"
theme[download_end]="#e1404a"

# Upload graph colors
theme[upload_start]="#e1404a"
theme[upload_mid]="#537e9c"
theme[upload_end]="#e1404a"
